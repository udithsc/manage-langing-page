{
  "name": "manage-landing-page",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npx @tailwindcss/cli -i ./input.css -o ./css/main.css --watch\" \"live-server --port=5173 --no-css-inject --wait=200 ./\"",
    "build": "npx @tailwindcss/cli -i ./input.css -o ./css/main.css && mkdir -p dist && cp -r index.html css images js dist/",
    "serve": "npm run build && live-server --port=8080 --no-css-inject ./dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "live-server": "^1.2.2",
    "@tailwindcss/cli": "^4.2.0",
    "parcel-bundler": "^1.12.5",
    "tailwindcss": "^4.2.0"
  }
}